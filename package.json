{
  "name": "api-solid-nodejs",
  "version": "1.0.0",
  "description": "GymPass style app.",
  "homepage": "https://github.com/PedroLimass/api-solid-nodejs#readme",
  "bugs": {
    "url": "https://github.com/PedroLimass/api-solid-nodejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroLimass/api-solid-nodejs.git"
  },
  "license": "ISC",
  "author": "",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "start:dev": "tsx watch src/server.ts",
    "start": "node build/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "tsup src --out-dir build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "studio": "prisma studio",
    "db:generate": "prisma generate",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@rocketseat/eslint-config": "2.2.2",
    "@types/node": "^25.9.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "8.57.1",
    "prettier-plugin-prisma": "5.0.0",
    "prisma": "7.8.0",
    "supertest": "7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.7"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/jwt": "10.1.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@vitest/ui": "4.1.7",
    "bcryptjs": "3.0.3",
    "dayjs": "1.11.21",
    "dotenv": "17.4.2",
    "fastify": "^5.8.5",
    "pg": "8.21.0",
    "zod": "4.4.3"
  }
}
